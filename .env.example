# 在 Sentry 项目的 Client Keys (DSN) 页面获取
VITE_SENTRY_DSN=
VITE_SENTRY_TUNNEL=
VITE_BASE_PATH=/

# 可按部署环境覆盖，例如 production、staging、development
VITE_APP_ENV=development
VITE_SENTRY_RELEASE=vue-sentry-starter@local

# 仅在构建时使用，不会进入浏览器代码。
SENTRY_URL=https://sentry.io/
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
